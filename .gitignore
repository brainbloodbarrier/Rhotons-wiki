# Secrets and local env
.env
.env.local

# OS / editor noise
.DS_Store
*.pyc
__pycache__/

# Large binary sources (kept outside repo per AGENTS.md)
*.pdf

# Datalab extractions — raw figure/JSON payloads regeneratable via Datalab API
# Campaign-complete extractions are purged from git to keep repo lean.
# Local copies are fine but should not be tracked.
**/extractions/datalab/

# Agent state (local only) — recursive patterns cover every vault
**/.omc/
**/.trash/
.remember/
.ruff_cache/
.claude/worktrees/

# Autoresearch output (moved to .autoresearch/<wiki>/ in Phase 3)
autoresearch-results.tsv
*-autoresearch-results.tsv
.autoresearch/**
!.autoresearch/.gitkeep
# Track curated per-wiki deliverables (audits, campaign specs, revise queue).
# Raw iteration logs (results.tsv) remain ignored.
!.autoresearch/*/
.autoresearch/*/**
!.autoresearch/*/audits/
!.autoresearch/*/audits/**
!.autoresearch/*/campaigns/
!.autoresearch/*/campaigns/**
!.autoresearch/*/revise-queue.md

# Obsidian plugin state (machine-generated, per-user)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/appearance.json
.obsidian/plugins/*/data.json

# Vault-level plugin/embedding caches (machine-generated)
**/.smart-env/
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/appearance.json
**/.obsidian/plugins/*/data.json

# Agent skill symlinks (created by setup.sh) — these are just pointers to .skills/
# We track them so cloners get the symlinks too, but if your git doesn't
# preserve symlinks, run `bash setup.sh` after cloning.
*.md.bak
